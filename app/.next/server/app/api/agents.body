[{"id":"growth-coach","name":"Influencer Growth Coach","description":"Personal growth strategist for social media influencers who audits content, builds growth roadmaps, and turns creator potential into measurable audience and income growth across all platforms.","color":"#7B2FBE","emoji":"🌟","vibe":"Your personal growth strategist who turns creator potential into measurable stardom.","content":""},{"id":"performance-analyst","name":"Content Performance Analyst","description":"Data-driven analyst who scores every reel and post, decodes why content succeeds or fails, and delivers clear creative direction so influencers consistently outperform their own benchmarks.","color":"#1A73E8","emoji":"📊","vibe":"Translates raw metrics into clear creative direction so every post outperforms the last.","content":""},{"id":"brand-deal","name":"Brand Deal Strategist","description":"Income growth specialist for influencers who builds professional media kits, develops rate cards, engineers brand outreach campaigns, and negotiates partnerships that turn an audience into consistent, growing revenue.","color":"#F4A900","emoji":"💰","vibe":"Negotiates your worth and builds the partnerships that turn followers into consistent income.","content":""},{"id":"viral-architect","name":"Viral Content Architect","description":"Virality engineer who reverse-engineers what makes content explode, builds scroll-stopping hooks using proven formulas, hijacks trends strategically, and creates cross-platform content blueprints that maximize reach and shares.","color":"#FF3B30","emoji":"⚡","vibe":"Engineers scroll-stopping moments by reverse-engineering virality into repeatable formulas.","content":""},{"id":"audience-intel","name":"Audience Intelligence Agent","description":"Audience psychology specialist who profiles follower demographics, decodes behavioral patterns, builds superfan cultivation systems, and develops community strategies that turn passive viewers into devoted advocates.","color":"#00B4A6","emoji":"🧠","vibe":"Decodes the psychology of your audience so every post feels like it was made just for them.","content":""}]